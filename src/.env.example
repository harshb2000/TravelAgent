# LLM (required)
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# Small model used only to generate progress labels
PROGRESS_LLM_BASE_URL=http://localhost:11434/v1
PROGRESS_LLM_API_KEY=ollama
PROGRESS_LLM_MODEL=qwen3.5:0.8b

# Per-model headers and per-specialist tuning (reasoning effort, iterations, timeouts)
# are configured in config/specialist_tuning.py, not here.

# SerpApi (required for flight search)
SERPAPI_API_KEY=...

# Tavily (required for web search)
TAVILY_API_KEY=tvly-...

# Open-Meteo: no key needed
# Frankfurter: no key needed
